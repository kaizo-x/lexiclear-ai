# LexiClear AI - Environment Variables
# API keys are optional. The platform operates 100% offline with pre-bundled local data engines.

# Generative AI Service Provider API Key (Optional: OpenAI / Gemini / Custom LLM API)
VITE_LLM_API_KEY=your_api_key_here
VITE_LLM_MODEL=gemini-1.5-pro

# Environment Setting
VITE_APP_ENV=production
